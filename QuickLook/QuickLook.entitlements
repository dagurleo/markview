<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App extensions must be sandboxed. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<key>com.apple.security.files.user-selected.read-only</key>
	<true/>
	<!-- For images a document loads from the web. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Quick Look only grants access to the previewed file itself. Reading the
	     images next to it, wherever the document lives, takes this exception. -->
	<key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
	<array>
		<string>/</string>
	</array>
	<!-- The app's settings, so that previews look like its windows (Native/Settings.swift). -->
	<key>com.apple.security.temporary-exception.shared-preference.read-only</key>
	<array>
		<string>com.dagurleo.markview</string>
	</array>
</dict>
</plist>
