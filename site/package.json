{
  "name": "markview-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && bunx wrangler deploy",
    "lint": "eslint",
    "format": "prettier --write \"**/*.{ts,tsx,css}\"",
    "check": "prettier --check \"**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit"
