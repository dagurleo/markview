    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^9",
    "prettier": "^3.9.9",
    "typescript": "^6",
    "vite": "^8.3.4",
    "wrangler": "^4.148.0"
